---
import "../styles/global.css";
import BrandWordmark from "../components/BrandWordmark.astro";
import CloudBackdrop from "../components/CloudBackdrop.astro";

interface Props {
  title: string;
  description: string;
  pageClass?: string;
  currentPage?: "account" | "login" | "device" | "result" | "error" | "desktop";
}

const { title, description, pageClass = "", currentPage = "login" } = Astro.props;
const isAccount = currentPage === "account";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F7F8F3" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/icons/lomi-v1.3.svg?v=lime" />
    <link rel="preload" href="/fonts/Geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · Lomi</title>
  </head>
  <body class={pageClass} data-page={currentPage}>
    <CloudBackdrop />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <BrandWordmark />
      <main id="main-content" tabindex="-1" class:list={["main-content", isAccount && "main-content-account"]}>
        <slot />
      </main>
    </div>
  </body>
</html>
