---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Device request result"
  description="See the result of your Lomi desktop sign-in request."
  pageClass="page-result"
  currentPage="result"
>
  <section id="result-panel" class="result-panel panel" aria-labelledby="result-title">
    <div id="result-symbol" class="result-symbol" aria-hidden="true">✓</div>
    <span id="result-eyebrow" class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Device sign-in</span>
    <h1 id="result-title">Device approved</h1>
    <p id="result-copy" class="copy">Return to Lomi desktop to finish signing in. The app will confirm when your session is saved.</p>
    <div id="result-note" class="notice notice-success result-note" role="status" aria-live="polite">
      Lomi desktop securely completes sign-in after it receives your approval.
    </div>
    <a id="result-action" class="button button-primary button-full" href="/account">Go to your account</a>
    <p class="result-footnote">You can close this tab after you return to the Lomi app.</p>
    <noscript><p class="notice notice-info">This page displays the result of the device action you submitted.</p></noscript>
  </section>
</BaseLayout>

<script src="../../scripts/device-result.ts"></script>

<style>
  .result-panel {
    width: min(100%, 480px);
    padding: clamp(28px, 6vw, 47px);
    text-align: center;
  }

  .result-symbol {
    display: grid;
    width: 68px;
    height: 68px;
    margin: 0 auto 19px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--success) 26%, var(--line));
    border-radius: 50%;
    background: var(--success-bg);
    color: var(--success);
    font-size: 29px;
    font-weight: 800;
  }

  .result-panel .eyebrow {
    justify-content: center;
  }

  .result-panel h1 {
    margin-top: 12px;
    font-size: clamp(32px, 6vw, 42px);
  }

  .result-panel .copy {
    margin-bottom: 20px;
    font-size: 13px;
  }

  .result-note {
    margin-bottom: 19px;
    text-align: left;
  }

  .result-footnote {
    margin: 15px 0 0;
    color: var(--text-muted);
    font-size: 11px;
  }
</style>
