---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Log in to Remote" description="Continue to Lomi Remote with your Lomi account." pageClass="page-device">
  <section class="panel remote-panel" aria-labelledby="remote-title">
    <h1 id="remote-title">Log in to Remote</h1>
    <p id="remote-status" class="loading-line" role="status" aria-live="polite">Checking your Lomi session…</p>
    <a id="remote-login" class="button button-primary button-full" href="/login" hidden>Sign in with GitHub</a>
    <div id="remote-review" hidden>
      <div class="remote-account-card">
        <div class="remote-avatar" aria-hidden="true">
          <span id="remote-initials"></span>
          <img id="remote-avatar" width="56" height="56" alt="" referrerpolicy="no-referrer" hidden />
        </div>
        <div class="remote-account-info">
          <p id="remote-account" class="remote-account-name"></p>
          <p id="remote-github" class="remote-account-login" hidden></p>
        </div>
      </div>
      <section class="remote-access-note" aria-labelledby="remote-access-title">
        <h2 id="remote-access-title">About this access</h2>
        <p id="remote-access-description">Signing in lets Lomi Remote show hosts linked to your account. To use a project or terminal, its host must already be authorized for your account and sharing must be enabled on that host. This sign-in doesn’t authorize a new host or enable sharing.</p>
      </section>
      <button id="remote-approve" class="button button-primary button-full" type="button">Continue</button>
      <button id="remote-deny" class="remote-cancel" type="button">Cancel</button>
    </div>
    <p id="remote-error" class="notice notice-danger" role="alert" hidden></p>
    <noscript><p class="notice notice-warning">Enable JavaScript to continue to Lomi Remote.</p></noscript>
  </section>
</BaseLayout>
<script src="../scripts/remote.ts"></script>
<style>
  .remote-panel { width: min(100%, 440px); padding: clamp(24px, 5vw, 36px); text-align: center; }
  h1 { margin: 0 0 28px; font-size: clamp(28px, 4vw, 34px); text-wrap: balance; }
  #remote-status { margin-bottom: 20px; text-wrap: pretty; }
  .remote-account-card { display: flex; min-width: 0; align-items: center; gap: 16px; margin-bottom: 24px; border: 1px solid var(--line); border-radius: 12px; padding: 18px; background: var(--surface); text-align: left; }
  .remote-avatar { position: relative; display: grid; width: 56px; height: 56px; flex: 0 0 auto; place-items: center; overflow: hidden; border-radius: 50%; background: var(--surface-soft); color: var(--text-soft); font-size: 18px; font-weight: 600; }
  .remote-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .remote-account-info { min-width: 0; }
  .remote-account-name { margin: 0; font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
  .remote-account-login { margin: 3px 0 0; color: var(--text-muted); font-size: 12px; overflow-wrap: anywhere; }
  .remote-access-note { margin: 0 0 20px; border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; background: var(--surface); text-align: left; }
  .remote-access-note h2 { margin: 0 0 5px; font-size: 13px; font-weight: 600; }
  .remote-access-note p { margin: 0; color: var(--text-muted); font-size: 13px; line-height: 1.5; text-wrap: pretty; }
  .remote-cancel { min-height: 44px; margin-top: 8px; border: 0; border-radius: 9px; padding: 0 16px; background: transparent; color: var(--text-muted); cursor: pointer; font-size: 12px; }
  .remote-cancel:hover { color: var(--text); }
  #remote-error { margin: 16px 0 0; text-align: left; text-wrap: pretty; }
</style>
