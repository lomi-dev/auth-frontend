---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Signing in"
  description="Complete sign-in to Lomi desktop."
  pageClass="page-desktop"
  currentPage="desktop"
>
  <section class="desktop-status" aria-labelledby="desktop-title">
    <h1 id="desktop-title">Authenticating with GitHub</h1>
    <p id="desktop-status" class="desktop-copy" role="status" aria-live="polite">You will automatically be redirected.</p>
    <p id="desktop-error" class="desktop-error" role="alert" hidden></p>
    <noscript>
      <p class="notice notice-warning">Turn on JavaScript, then start sign-in again in Lomi.</p>
    </noscript>
  </section>
</BaseLayout>

<script src="../scripts/desktop.ts"></script>

<style>
  .desktop-status {
    width: min(100%, 520px);
    text-align: center;
  }

  .desktop-status h1 {
    margin-bottom: 12px;
    font-size: clamp(32px, 4vw, 40px);
  }

  .desktop-copy,
  .desktop-error {
    margin-bottom: 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .desktop-copy {
    color: var(--text-soft);
  }

  .desktop-error {
    color: var(--danger);
  }
</style>
